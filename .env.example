# Copy to .env and fill in. Never commit the real .env.
#
# Minimum to test every feature: just GROQ_API_KEY. Embeddings fall back to
# TF-IDF and storage falls back to local SQLite automatically when AWS/
# Supabase aren't configured -- see docs/DEVELOPMENT.md.

# --- Groq (default chat provider: free tier, no AWS) ----------------------
GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b

# --- Bedrock (optional -- real semantic embeddings instead of TF-IDF) -----
# Only uncomment AWS_PROFILE if you actually have that named profile set up
# (e.g. via `aws sso login --profile <name>`) -- an AWS_PROFILE pointing at a
# profile that doesn't exist on your machine will break boto3 entirely, not
# just fail gracefully. Leave both lines commented out to use the TF-IDF
# fallback with no AWS setup at all.
# AWS_PROFILE=<your-sso-profile-name>
# AWS_DEFAULT_REGION=ap-southeast-1
# LLM_PROVIDER=bedrock                # uncomment to also use Bedrock for chat
# BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- Supabase (optional -- shared/hosted storage instead of local SQLite) -
# Project Settings -> API -> Project URL / service_role key
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJ...
